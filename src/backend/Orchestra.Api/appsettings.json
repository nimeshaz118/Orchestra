{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "Orchestra.Api",
    "Audience": "Orchestra.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ResetTokenMinutes": 10
  },
  "Frontend": {
    "Origins": ["http://localhost:5173"]
  }
}
